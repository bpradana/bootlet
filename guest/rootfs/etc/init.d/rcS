#!/bin/sh
. /lib/bootlet-status.sh

mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
ok "Mounted /tmp, /run and /dev/pts."
hostname -F /etc/hostname
ok "Set hostname to $(hostname)."
ip link set lo up
ok "Brought up loopback interface lo."

# Networking: user-mode NAT provided by the emulator (see README).
if [ -e /sys/class/net/eth0 ]; then
  ip link set eth0 up &&
    ip addr add 10.0.2.15/24 dev eth0 &&
    ip route add default via 10.0.2.2 &&
    echo "nameserver 10.0.2.3" > /etc/resolv.conf &&
    ok "Configured network eth0: 10.0.2.15/24, gateway 10.0.2.2, DNS 10.0.2.3." ||
    fail "Could not configure network interface eth0."
fi
ok "Started login shell on the serial console (ttyS0)."

cat /etc/motd
if [ -e /sys/class/net/eth0 ]; then
  echo "  Network is up: try \`apk add python3\` or \`wget -qO- http://example.com\`."
else
  echo "  No network: open the page with ?relay=wss://<your relay>/ to enable it."
fi
if grep -q ' / overlay ' /proc/mounts; then
  echo "  Changes to the filesystem are saved in this browser (toolbar: Reset disk)."
fi
echo
